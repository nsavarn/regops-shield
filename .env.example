# RegOps Shield - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# ============================================================
# Application Settings
# ============================================================
APP_NAME=RegOps Shield
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ============================================================
# API Server
# ============================================================
HOST=0.0.0.0
PORT=8080
WORKERS=2

# ============================================================
# Google Cloud / Vertex AI (required)
# ============================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ============================================================
# MongoDB Atlas (required)
# ============================================================
MONGO_URI=your_mongodb_atlas_connection_string_here
MONGO_CLUSTER_NAME=your_cluster_name
ATLAS_DATABASE=regops_shield
ATLAS_POLICIES_COLLECTION=policies
ATLAS_SESSIONS_COLLECTION=shadow_sessions
VECTOR_INDEX_NAME=policies_vector_index

# ============================================================
# Security
# ============================================================
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
API_KEY_HEADER=X-API-Key

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================
# Feature Flags
# ============================================================
ENABLE_SHADOW_RUN=true
ENABLE_COMPLIANCE_AGENT=true
ENABLE_POLICY_AGENT=true
ENABLE_REPORT_AGENT=true

# ============================================================
# Cloud Run Deployment
# ============================================================
CLOUD_RUN_SERVICE=regops-shield
CLOUD_RUN_REGION=us-central1
CONTAINER_REGISTRY=gcr.io

# ============================================================
# Observability
# ============================================================
ENABLE_METRICS=true
METRICS_PORT=9090
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
