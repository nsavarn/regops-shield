# RegOps Shield — Environment Configuration
# Copy to .env and fill in values

# Google Cloud (required)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id

# MongoDB Atlas (required)
MONGODB_URI=your_mongodb_atlas_connection_string_here
ATLAS_CLUSTER_NAME=your_cluster_name
ATLAS_DATABASE=regops_shield
ATLAS_POLICIES_COLLECTION=policies
ATLAS_SESSIONS_COLLECTION=shadow_sessions

# Vector Search (optional — for MongoDB Atlas Vector Search)
GOOGLE_EMBEDDING_MODEL=text-embedding-004
VECTOR_INDEX_NAME=policies_vector_index

# Cloud Run Deployment
PORT=8080

# General
LOG_LEVEL=INFO
